{
  "name": "goober",
  "version": "2.1.18",
  "description": "A less than 1KB css-in-js solution",
  "license": "MIT",
  "author": "Cristian <botecristian@yahoo.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/cristianbote/goober"
  },
  "keywords": [
    "css-in-js",
    "goober",
    "styled",
    "javascript",
    "react",
    "preact"
  ],
  "sideEffects": false,
  "type": "module",
  "types": "./src/core/index.ts",
  "module": "./src/core/index.ts",
  "exports": {
    ".": {
      "types": "./src/core/index.ts",
      "import": "./src/core/index.ts"
    },
    "./plugins": {
      "types": "./src/plugins/index.ts",
      "import": "./src/plugins/index.ts"
    },
    "./theme": {
      "types": "./src/theme/index.ts",
      "import": "./src/theme/index.ts"
    }
  },
  "scripts": {
    "build": "vite build && tsc --noEmit false",
    "lint": "cd ../../ && pnpm run lint",
    "lint:fix": "cd ../../ && pnpm run lint:fix"
  },
  "devDependencies": {
    "vite": "8.0.12"
  }
}
